# Copy to .env and fill in only the platforms you want live.
# Leave blank to keep that platform in demo mode (sample data).

# Master switch: serve sample data for any unconfigured platform.
DEMO_MODE=true

# --- Telegram (my.telegram.org -> API development tools) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=unified_messenger

# --- Discord (discord.com/developers -> bot token) ---
DISCORD_BOT_TOKEN=

# --- Slack (api.slack.com/apps -> OAuth token xoxp-/xoxb-) ---
SLACK_TOKEN=

# --- Substack (comma-separated RSS feed URLs) ---
SUBSTACK_FEEDS=

# Server
HOST=127.0.0.1
PORT=8000

# Shared secret. Required whenever live adapter credentials are configured.
# Leave blank only for credential-free demos. Set a long random value before
# exposing the backend on a network / deploying — then the app must pass the
# same value via: flutter run --dart-define=API_KEY=<value>
API_KEY=

# Firebase service-account JSON path — enables real FCM push for help alerts.
# Leave blank to disable push (everything else still works). See
# app/fcm_setup/SETUP_FCM.md.
FIREBASE_CREDENTIALS=
